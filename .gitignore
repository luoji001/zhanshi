# 依赖（360MB，绝不入库）
/node_modules

# Next.js 构建产物
/.next/
/out/
/build

# Wrangler 本地状态（deploy / login 生成，不属于项目源码）
/.wrangler/

# TypeScript 增量构建缓存
*.tsbuildinfo
next-env.d.ts

# 本地环境变量
.env
.env*.local

# Wrangler 的本地密钥文件（wrangler dev 读它；里面是 HASH_SALT / STATS_TOKEN /
# CF_API_TOKEN 这类真密钥，**绝不能入库**。线上用 `wrangler secret put` 设置）
.dev.vars
.dev.vars.*

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 系统文件
.DS_Store
*.pem
